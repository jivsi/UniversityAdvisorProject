@model UniversityFinder.Models.University
@{
    ViewData["Title"] = Model.Name;
    var isFavorited = ViewBag.IsFavorited as bool? ?? false;
}

<!-- Hero Section with Parallax -->
<section class="relative h-[60vh] min-h-[500px] overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-green-600 via-emerald-500 to-green-500"></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23ffffff" fill-opacity="0.05"%3E%3Cpath d="M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-20"></div>
    
    <div class="absolute inset-0 flex items-end">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 w-full">
            <div class="flex flex-col md:flex-row items-end justify-between gap-6">
                <div class="flex-1">
                    <h1 class="text-4xl md:text-6xl font-bold font-display text-white mb-4">@Model.Name</h1>
                    <div class="flex items-center gap-4 text-white/90">
                        <div class="flex items-center gap-2">
                            <i data-lucide="map-pin" class="w-5 h-5"></i>
                            <span>@(Model.City ?? "Неизвестен град")</span>
                        </div>
                    </div>
                </div>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button 
                        id="favoriteBtn" 
                        class="px-6 py-3 rounded-2xl font-semibold transition-all transform hover:scale-105 @(isFavorited ? "bg-yellow-500 text-white" : "bg-white/20 backdrop-blur-sm text-white border-2 border-white/30")"
                        data-university-id="@Model.Id"
                    >
                        <div class="flex items-center gap-2">
                            <i data-lucide="@(isFavorited ? "star" : "star")" class="w-5 h-5 @(isFavorited ? "fill-current" : "")"></i>
                            <span id="favoriteText">@(isFavorited ? "В Любими" : "Добави в Любими")</span>
                        </div>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

<!-- Floating Info Panel -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-20 relative z-10 mb-12">
    <div class="glass dark:glass-dark rounded-3xl p-8 shadow-2xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="text-center">
                <div class="text-3xl font-bold gradient-text mb-2">@Model.Programs.Count</div>
                <div class="text-sm text-gray-600 dark:text-gray-400">Специалности</div>
            </div>
            <div class="text-center">
                <div class="text-3xl font-bold gradient-text mb-2">@(Model.City ?? "Неизвестен град")</div>
                <div class="text-sm text-gray-600 dark:text-gray-400">Град</div>
            </div>
            <div class="text-center">
                <div class="flex items-center justify-center gap-1 mb-2">
                    @for (int i = 0; i < 5; i++)
                    {
                        <i data-lucide="star" class="w-5 h-5 text-yellow-400 fill-current"></i>
                    }
                </div>
                <div class="text-sm text-gray-600 dark:text-gray-400">Рейтинг</div>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Main Content Area -->
        <div class="flex-1">
            <!-- Tabs -->
            <div class="mb-8">
                <div class="flex space-x-1 glass dark:glass-dark rounded-2xl p-2 inline-flex">
                    <button class="tab-btn active px-6 py-3 rounded-xl font-semibold transition-all bg-gradient-to-r from-green-600 to-emerald-600 text-white" data-tab="overview">
                        Преглед
                    </button>
                    <button class="tab-btn px-6 py-3 rounded-xl font-semibold transition-all text-gray-600 dark:text-gray-400 hover:bg-green-50 dark:hover:bg-gray-800" data-tab="programs">
                        Специалности
                    </button>
                </div>
            </div>
            
            <!-- Tab Content -->
            <div id="tab-content">
                <!-- Overview Tab -->
                <div id="overview" class="tab-panel active">
                    <div class="glass dark:glass-dark rounded-3xl p-8 mb-6">
                        <h2 class="text-3xl font-bold mb-6">Информация</h2>
                        <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
                            @Model.Name се намира в @(Model.City ?? "непосочен град").
                        </p>
                        
                        <!-- Contact Information -->
                        @if (!string.IsNullOrWhiteSpace(Model.Website) || !string.IsNullOrWhiteSpace(Model.Email) || !string.IsNullOrWhiteSpace(Model.Phone) || !string.IsNullOrWhiteSpace(Model.Address))
                        {
                            <div class="mt-8 pt-8 border-t border-white/10 dark:border-white/5">
                                <h3 class="text-xl font-bold mb-4">Контактна Информация</h3>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    @if (!string.IsNullOrWhiteSpace(Model.Website))
                                    {
                                        <div class="flex items-start gap-3">
                                            <div class="w-10 h-10 rounded-lg bg-green-500/20 flex items-center justify-center flex-shrink-0">
                                                <i data-lucide="globe" class="w-5 h-5 text-green-400"></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Уебсайт</div>
                                                <a href="@Model.Website" target="_blank" rel="noopener noreferrer" class="text-green-400 hover:text-green-300 hover:underline break-all">
                                                    @Model.Website
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                                    {
                                        <div class="flex items-start gap-3">
                                            <div class="w-10 h-10 rounded-lg bg-blue-500/20 flex items-center justify-center flex-shrink-0">
                                                <i data-lucide="mail" class="w-5 h-5 text-blue-400"></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Имейл</div>
                                                <a href="mailto:@Model.Email" class="text-blue-400 hover:text-blue-300 hover:underline break-all">
                                                    @Model.Email
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (!string.IsNullOrWhiteSpace(Model.Phone))
                                    {
                                        <div class="flex items-start gap-3">
                                            <div class="w-10 h-10 rounded-lg bg-green-500/20 flex items-center justify-center flex-shrink-0">
                                                <i data-lucide="phone" class="w-5 h-5 text-green-400"></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Телефон</div>
                                                <a href="tel:@Model.Phone" class="text-green-400 hover:text-green-300 hover:underline">
                                                    @Model.Phone
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    
                                    @if (!string.IsNullOrWhiteSpace(Model.Address))
                                    {
                                        <div class="flex items-start gap-3 md:col-span-2">
                                            <div class="w-10 h-10 rounded-lg bg-orange-500/20 flex items-center justify-center flex-shrink-0">
                                                <i data-lucide="map-pin" class="w-5 h-5 text-orange-400"></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Адрес</div>
                                                <p class="text-gray-700 dark:text-gray-300 break-words">
                                                    @Model.Address
                                                </p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
                <!-- Specialties Tab -->
                <div id="programs" class="tab-panel hidden">
                    <div class="glass dark:glass-dark rounded-3xl p-8">
                        <h2 class="text-3xl font-bold mb-6">Специалности</h2>
                        
                        @if (Model.Programs != null && Model.Programs.Any())
                        {
                            <div class="mb-6 flex flex-wrap gap-2" id="degreeFilters">
                                <button type="button"
                                        class="degree-filter-btn active px-4 py-2 rounded-xl text-sm font-semibold transition-all bg-gradient-to-r from-green-600 to-emerald-600 text-white"
                                        data-degree="all">
                                    Всички
                                </button>
                                <button type="button"
                                        class="degree-filter-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all text-gray-600 dark:text-gray-400 hover:bg-green-50 dark:hover:bg-gray-800"
                                        data-degree="бакалавър">
                                    Бакалавър
                                </button>
                                <button type="button"
                                        class="degree-filter-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all text-gray-600 dark:text-gray-400 hover:bg-green-50 dark:hover:bg-gray-800"
                                        data-degree="магистър">
                                    Магистър
                                </button>
                                <button type="button"
                                        class="degree-filter-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all text-gray-600 dark:text-gray-400 hover:bg-green-50 dark:hover:bg-gray-800"
                                        data-degree="доктор">
                                    Доктор
                                </button>
                            </div>

                            <div id="programsEmptyFiltered" class="hidden text-center py-8">
                                <div class="w-16 h-16 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-3">
                                    <i data-lucide="filter-x" class="w-8 h-8 text-gray-400"></i>
                                </div>
                                <p class="text-gray-500 dark:text-gray-400">Няма специалности за избраната степен.</p>
                            </div>

                            <div id="programsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                @foreach (var program in Model.Programs.OrderBy(p => p.Subject?.Name ?? p.Name))
                                {
                                    <div class="program-card bg-white/50 dark:bg-gray-800/50 rounded-2xl p-6 hover:shadow-lg transition-all border border-white/20 dark:border-white/10"
                                         data-degree="@((program.DegreeType ?? string.Empty).Trim().ToLowerInvariant())">
                                        <div class="flex items-start justify-between mb-2">
                                            <h3 class="text-lg font-bold">@(string.IsNullOrEmpty(program.Name) ? program.Subject?.Name : program.Name)</h3>
                                            @if (!string.IsNullOrEmpty(program.DegreeType))
                                            {
                                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200">
                                                    @program.DegreeType
                                                </span>
                                            }
                                        </div>
                                        
                                        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600 dark:text-gray-400 mt-4">
                                            <span class="flex items-center gap-2">
                                                <i data-lucide="book-open" class="w-4 h-4"></i>
                                                @(program.Subject?.Name ?? "Обща специалност")
                                            </span>
                                            @* Такса: премахнато *@
                                        </div>

                                        <div class="mt-5 flex justify-end">
                                            <button type="button"
                                                    class="px-4 py-2 rounded-xl text-sm font-semibold bg-white/30 dark:bg-gray-700/30 hover:bg-white/40 dark:hover:bg-gray-700/40 transition-colors flex items-center gap-2"
                                                    onclick="openProgramDialog('@program.Id')">
                                                <i data-lucide="info" class="w-4 h-4"></i>
                                                Детайли
                                            </button>
                                        </div>
                                    </div>

                                    <dialog id="program-dialog-@program.Id" class="program-dialog rounded-2xl p-0 w-[92vw] max-w-lg bg-transparent">
                                        <div class="glass dark:glass-dark rounded-3xl p-6 border border-white/20 dark:border-white/10">
                                            <div class="flex items-start justify-between gap-4">
                                                <div class="min-w-0">
                                                    <h3 class="text-xl font-bold break-words">@(string.IsNullOrEmpty(program.Name) ? program.Subject?.Name : program.Name)</h3>
                                                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 break-words">
                                                        @(program.Subject?.Name ?? "Обща специалност")
                                                    </p>
                                                </div>
                                                <button type="button"
                                                        class="p-2 rounded-xl text-emerald-200 hover:text-white hover:bg-white/20 dark:hover:bg-white/10 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400/80"
                                                        onclick="closeProgramDialog('@program.Id')"
                                                        aria-label="Затвори">
                                                    <i data-lucide="x" class="w-5 h-5"></i>
                                                </button>
                                            </div>

                                            <div class="mt-6 space-y-3 text-sm">
                                                <div class="flex items-center justify-between gap-4">
                                                    <span class="text-gray-300">Степен</span>
                                                    <span class="font-semibold text-white">@(!string.IsNullOrWhiteSpace(program.DegreeType) ? program.DegreeType : "—")</span>
                                                </div>
                                                <div class="flex items-center justify-between gap-4">
                                                    <span class="text-gray-300">Вид обучение</span>
                                                    <span class="font-semibold text-white">@(!string.IsNullOrWhiteSpace(program.StudyForm) ? program.StudyForm : "—")</span>
                                                </div>
                                                <div class="flex items-center justify-between gap-4">
                                                    <span class="text-gray-300">Продължителност (години)</span>
                                                    <span class="font-semibold text-white">@(program.Duration.HasValue ? program.Duration.Value.ToString() : "—")</span>
                                                </div>
                                                @* Такса: премахнато *@
                                            </div>

                                            <div class="mt-6 flex justify-end">
                                                <button type="button"
                                                        class="px-5 py-2 rounded-xl font-semibold bg-gradient-to-r from-green-600 to-emerald-600 text-white hover:shadow-lg transition-all"
                                                        onclick="closeProgramDialog('@program.Id')">
                                                    Затвори
                                                </button>
                                            </div>
                                        </div>
                                    </dialog>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-12">
                                <div class="w-20 h-20 bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center mx-auto mb-4">
                                    <i data-lucide="book-x" class="w-10 h-10 text-gray-400"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Няма налични специалности</h3>
                                <p class="text-gray-500 dark:text-gray-400">Все още няма добавени специалности за този университет.</p>
                            </div>
                        }
                    </div>
                </div>
                
            </div>
        </div>
        
        <!-- Sidebar -->
        <aside class="lg:w-80 flex-shrink-0">
            <div class="glass dark:glass-dark rounded-3xl p-6 sticky top-24">
                <h3 class="text-xl font-bold mb-6">Бърза Информация</h3>
                <div class="space-y-4">
                    <div>
                        <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Град</div>
                        <div class="font-semibold">@(Model.City ?? "Неизвестен град")</div>
                    </div>
                    <div>
                        <div class="text-sm text-gray-600 dark:text-gray-400 mb-1">Програми</div>
                        <div class="font-semibold">@Model.Programs.Count</div>
                    </div>
                </div>
                
                @if (!string.IsNullOrWhiteSpace(Model.City) && !string.Equals(Model.City, "Unknown", StringComparison.OrdinalIgnoreCase))
                {
                    <a 
                        asp-controller="University" 
                        asp-action="Index" 
                        asp-route-city="@Model.City" 
                        class="block w-full mt-6 px-4 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white text-center rounded-xl font-semibold hover:shadow-lg transform hover:scale-105 transition-all"
                    >
                        Още университети в @Model.City
                    </a>
                }
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <style>
        /* Keep selection and focus styles consistent in program dialogs */
        dialog.program-dialog:focus { outline: none; }
        dialog.program-dialog::selection { background: rgba(16, 185, 129, 0.35); color: #fff; }
        dialog.program-dialog *::selection { background: rgba(16, 185, 129, 0.35); color: #fff; }
        dialog.program-dialog::backdrop { background: rgba(0, 0, 0, 0.55); }
    </style>
    <script>
        lucide.createIcons();
        
        // Tab functionality
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const tabName = this.dataset.tab;
                
                // Update active tab button
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('active', 'bg-gradient-to-r', 'from-green-600', 'to-emerald-600', 'text-white');
                    b.classList.add('text-gray-600', 'dark:text-gray-400');
                });
                this.classList.add('active', 'bg-gradient-to-r', 'from-green-600', 'to-emerald-600', 'text-white');
                this.classList.remove('text-gray-600', 'dark:text-gray-400');
                
                // Show/hide tab panels
                document.querySelectorAll('.tab-panel').forEach(panel => {
                    panel.classList.add('hidden');
                    panel.classList.remove('active');
                });
                const targetPanel = document.getElementById(tabName);
                if (targetPanel) {
                    targetPanel.classList.remove('hidden');
                    targetPanel.classList.add('active');
                }
            });
        });

        // Programs degree filters
        const degreeFilterButtons = document.querySelectorAll('.degree-filter-btn');
        const programCards = document.querySelectorAll('.program-card');
        const programsEmptyFiltered = document.getElementById('programsEmptyFiltered');

        function normalizeDegree(value) {
            return (value || '').trim().toLowerCase();
        }

        function setActiveDegreeFilter(activeButton) {
            degreeFilterButtons.forEach(btn => {
                btn.classList.remove('active', 'bg-gradient-to-r', 'from-green-600', 'to-emerald-600', 'text-white');
                btn.classList.add('text-gray-600', 'dark:text-gray-400');
            });

            activeButton.classList.add('active', 'bg-gradient-to-r', 'from-green-600', 'to-emerald-600', 'text-white');
            activeButton.classList.remove('text-gray-600', 'dark:text-gray-400');
        }

        function applyDegreeFilter(degree) {
            let visibleCount = 0;
            const normalizedWanted = normalizeDegree(degree);

            programCards.forEach(card => {
                const programDegree = normalizeDegree(card.dataset.degree);
                const matches = normalizedWanted === 'all' || programDegree === normalizedWanted;
                card.classList.toggle('hidden', !matches);
                if (matches) visibleCount++;
            });

            if (programsEmptyFiltered) {
                programsEmptyFiltered.classList.toggle('hidden', visibleCount > 0);
            }
        }

        degreeFilterButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                const degree = this.dataset.degree || 'all';
                setActiveDegreeFilter(this);
                applyDegreeFilter(degree);
            });
        });

        // Program details dialogs
        function openProgramDialog(id) {
            const dlg = document.getElementById(`program-dialog-${id}`);
            if (!dlg) return;
            if (typeof dlg.showModal === 'function') {
                dlg.showModal();
            } else {
                dlg.setAttribute('open', 'open');
            }
            lucide.createIcons();
        }

        function closeProgramDialog(id) {
            const dlg = document.getElementById(`program-dialog-${id}`);
            if (!dlg) return;
            if (typeof dlg.close === 'function') {
                dlg.close();
            } else {
                dlg.removeAttribute('open');
            }
        }

        window.openProgramDialog = openProgramDialog;
        window.closeProgramDialog = closeProgramDialog;
        
        // Favorite toggle
        $('#favoriteBtn').click(function() {
            var universityId = $(this).data('university-id');
            var btn = $(this);
            var text = $('#favoriteText');
            var icon = btn.find('i');

            if (!universityId) {
                alert('Липсва ID на университета.');
                return;
            }

            btn.prop('disabled', true);

            fetch('@Url.Action("ToggleFavoriteByGuid", "University")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `universityId=${encodeURIComponent(universityId)}`
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                return response.json();
            })
            .then(response => {
                if (response.favorited) {
                    btn.removeClass('bg-white/20 border-white/30').addClass('bg-yellow-500');
                    text.text('В Любими');
                    icon.addClass('fill-current');
                } else {
                    btn.removeClass('bg-yellow-500').addClass('bg-white/20 border-white/30');
                    text.text('Добави в Любими');
                    icon.removeClass('fill-current');
                }
                lucide.createIcons();
            })
            .catch(() => {
                alert('Възникна грешка. Моля, опитайте отново.');
            })
            .finally(() => {
                btn.prop('disabled', false);
            });
        });
    </script>
}
