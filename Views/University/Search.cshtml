@model UniversityFinder.ViewModels.SearchViewModel
@{
    ViewData["Title"] = "Търсене на Университети";
}

<div class="container">
    <h2 class="mb-4">Търсене на Университети</h2>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
    {
        <div class="alert alert-danger">
            <h5>Грешка в Базата Данни</h5>
            <p>@ViewBag.ErrorMessage</p>
            <p>Моля, приложете миграциите на базата данни, като кликнете върху бутона "Приложи Миграции" на страницата за грешка, или изпълнете <code>dotnet ef database update</code> в терминала.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewBag.InfoMessage as string))
    {
        <div class="alert alert-info">
            <h5>Информация</h5>
            <p>@ViewBag.InfoMessage</p>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Search" method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Предмет / Специалност</label>
                    <input type="text" asp-for="Query" class="form-control" placeholder="напр. Психология, Инженерство" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Държава</label>
                    <select asp-for="CountryId" class="form-select" id="countrySelect">
                        <option value="">Всички Държави</option>
                        @foreach (var country in Model.Countries)
                        {
                            <option value="@country.Id">@country.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Град</label>
                    <select asp-for="CityId" class="form-select" id="citySelect">
                        <option value="">Всички Градове</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Степен</label>
                    <select asp-for="DegreeType" class="form-select">
                        <option value="">Всички</option>
                        <option value="Bachelor">Бакалавър</option>
                        <option value="Master">Магистър</option>
                        <option value="PhD">Доктор</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Търсене</button>
                    <a asp-action="Search" class="btn btn-secondary">Изчисти</a>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <div class="mb-3">
            <p class="text-muted">Намерени <strong>@Model.TotalResults</strong> университета, отговарящи на вашето търсене.</p>
        </div>

        @if (Model.Universities.Any())
        {
            <div class="row">
                @foreach (var university in Model.Universities)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <a asp-action="Details" asp-route-name="@university.Name" class="text-decoration-none">
                                        @university.Name
                                    </a>
                                </h5>
                                <p class="card-text">
                                    <i class="bi bi-geo-alt"></i> @(university.City ?? "Неизвестен град"), @(university.Country ?? "Неизвестна държава")
                                </p>
                                @if (university.Programs.Any())
                                {
                                    <div class="mb-2">
                                        <strong>Програми:</strong>
                                        <ul class="list-unstyled ms-3">
                                            @foreach (var program in university.Programs.Take(3))
                                            {
                                                <li>• @program.Name (@program.DegreeType)</li>
                                            }
                                            @if (university.Programs.Count > 3)
                                            {
                                                <li class="text-muted">... и още @(university.Programs.Count - 3)</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                <a asp-action="Details" asp-route-name="@university.Name" class="btn btn-sm btn-outline-primary">Виж Детайли</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalResults > Model.PageSize)
            {
                <nav aria-label="Странициране на резултатите от търсенето">
                    <ul class="pagination justify-content-center">
                        @if (Model.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?Query=@Model.Query&CountryId=@Model.CountryId&CityId=@Model.CityId&DegreeType=@Model.DegreeType&Page=@(Model.Page - 1)">Предишна</a>
                            </li>
                        }
                        <li class="page-item active">
                            <span class="page-link">Страница @Model.Page</span>
                        </li>
                        @if (Model.Page * Model.PageSize < Model.TotalResults)
                        {
                            <li class="page-item">
                                <a class="page-link" href="?Query=@Model.Query&CountryId=@Model.CountryId&CityId=@Model.CityId&DegreeType=@Model.DegreeType&Page=@(Model.Page + 1)">Следваща</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info">
                <h5>Не са намерени университети</h5>
                <p>Опитайте се да промените критериите за търсене или разгледайте всички университети.</p>
                <a asp-action="Index" class="btn btn-primary">Разгледай Всички Университети</a>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            <h5>Започнете Търсенето</h5>
            <p>Въведете предмет или специалност, за да намерите университети, които предлагат програми в тази област.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#countrySelect').change(function() {
                var countryId = $(this).val();
                var citySelect = $('#citySelect');
                
                citySelect.html('<option value="">Зареждане...</option>');
                
                if (countryId) {
                    $.getJSON('@Url.Action("GetCities", "University")', { countryId: countryId }, function(cities) {
                        citySelect.html('<option value="">Всички Градове</option>');
                        $.each(cities, function(i, city) {
                            citySelect.append($('<option></option>').val(city.id).text(city.name));
                        });
                    });
                } else {
                    citySelect.html('<option value="">Всички Градове</option>');
                }
            });
        });
    </script>
}

