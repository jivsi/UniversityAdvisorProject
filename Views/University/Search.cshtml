@model UniversityFinder.ViewModels.SearchViewModel
@{
    ViewData["Title"] = "Търсене на Университети";
}

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h1 class="text-4xl md:text-5xl font-bold font-display mb-4 gradient-text">Търсене на Университети</h1>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
        {
            <div class="mb-6 glass dark:glass-dark rounded-2xl p-4 border-l-4 border-red-500 bg-red-50/50 dark:bg-red-900/20">
                <div class="flex items-center gap-3">
                    <i data-lucide="alert-circle" class="w-6 h-6 text-red-500"></i>
                    <div>
                        <h5 class="font-semibold text-red-800 dark:text-red-200">Грешка в Базата Данни</h5>
                        <p class="text-red-700 dark:text-red-300">@ViewBag.ErrorMessage</p>
                        <p class="text-red-600 dark:text-red-400 text-sm mt-2">Моля, приложете миграциите на базата данни, като кликнете върху бутона "Приложи Миграции" на страницата за грешка, или изпълнете <code>dotnet ef database update</code> в терминала.</p>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewBag.InfoMessage as string))
        {
            <div class="mb-6 glass dark:glass-dark rounded-2xl p-4 border-l-4 border-blue-500 bg-blue-50/50 dark:bg-blue-900/20">
                <div class="flex items-center gap-3">
                    <i data-lucide="info" class="w-6 h-6 text-blue-500"></i>
                    <div>
                        <h5 class="font-semibold text-blue-800 dark:text-blue-200">Информация</h5>
                        <p class="text-blue-700 dark:text-blue-300">@ViewBag.InfoMessage</p>
                    </div>
                </div>
            </div>
        }

        <div class="glass dark:glass-dark rounded-3xl p-8 mb-8">
            <form asp-action="Search" method="get" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">Предмет / Специалност</label>
                        <input type="text" asp-for="Query" class="w-full px-4 py-3 rounded-xl bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-green-500 focus:outline-none" placeholder="напр. Психология, Инженерство" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Град</label>
                        <select asp-for="City" class="w-full px-4 py-3 rounded-xl bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-green-500 focus:outline-none" id="citySelect">
                            <option value="">Всички Градове</option>
                            @foreach (var city in Model.Cities)
                            {
                                <option value="@city" selected="@(Model.City == city)">@city</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Степен</label>
                        <select asp-for="DegreeType" class="w-full px-4 py-3 rounded-xl bg-white/50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 focus:ring-2 focus:ring-green-500 focus:outline-none">
                            <option value="">Всички</option>
                            <option value="Bachelor">Бакалавър</option>
                            <option value="Master">Магистър</option>
                            <option value="PhD">Доктор</option>
                        </select>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    <button type="submit" class="px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-xl font-semibold hover:shadow-lg transform hover:scale-105 transition-all flex items-center gap-2">
                        <i data-lucide="search" class="w-5 h-5"></i>
                        Търсене
                    </button>
                    <a asp-action="Search" class="px-6 py-3 bg-gray-500 text-white rounded-xl font-semibold hover:bg-gray-600 transition-colors">
                        Изчисти
                    </a>
                </div>
            </form>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="mb-6">
                <p class="text-gray-600 dark:text-gray-400 text-lg">Намерени <strong class="text-gray-900 dark:text-white">@Model.TotalResults</strong> университета, отговарящи на вашето търсене.</p>
            </div>

            @if (Model.Universities.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    @foreach (var university in Model.Universities)
                    {
                        <div class="glass dark:glass-dark rounded-3xl overflow-hidden card-hover group">
                            <!-- University Image/Logo Placeholder -->
                            <div class="h-48 bg-gradient-to-br from-green-500 via-emerald-500 to-green-400 relative overflow-hidden">
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <i data-lucide="building-2" class="w-20 h-20 text-white/30"></i>
                                </div>
                            </div>
                            
                            <!-- Card Content -->
                            <div class="p-6">
                                <div class="mb-3">
                                    <h3 class="text-xl font-bold mb-1 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">
                                        <a asp-action="Details" asp-route-name="@university.Name" class="hover:underline">
                                            @university.Name
                                        </a>
                                    </h3>
                                </div>
                                
                                <div class="flex items-center gap-2 text-gray-600 dark:text-gray-400 mb-4">
                                    <i data-lucide="map-pin" class="w-4 h-4"></i>
                                    <span class="text-sm">@(university.City ?? "Неизвестен град")</span>
                                </div>
                                
                                @if (university.Programs.Any())
                                {
                                    <div class="mb-4">
                                        <div class="text-sm font-semibold mb-2">Програми:</div>
                                        <ul class="space-y-1 text-sm text-gray-600 dark:text-gray-400">
                                            @foreach (var program in university.Programs.Take(3))
                                            {
                                                <li class="flex items-center gap-2">
                                                    <i data-lucide="book-open" class="w-3 h-3"></i>
                                                    <span>@program.Name (@program.DegreeType)</span>
                                                </li>
                                            }
                                            @if (university.Programs.Count > 3)
                                            {
                                                <li class="text-gray-500 dark:text-gray-400 text-xs">... и още @(university.Programs.Count - 3)</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                
                                <!-- Action Button -->
                                <a 
                                    asp-action="Details" 
                                    asp-route-name="@university.Name" 
                                    class="block w-full px-4 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white text-center rounded-xl font-semibold hover:shadow-lg transform hover:scale-105 transition-all"
                                >
                                    Виж Детайли
                                </a>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.TotalResults > Model.PageSize)
                {
                    <nav aria-label="Странициране на резултатите от търсенето" class="mt-8">
                        <div class="flex items-center justify-center gap-2">
                            @if (Model.Page > 1)
                            {
                                <a class="px-4 py-2 bg-white/50 dark:bg-gray-800/50 rounded-xl hover:bg-white/70 dark:hover:bg-gray-700/50 transition-colors" href="?Query=@Model.Query&City=@Model.City&DegreeType=@Model.DegreeType&Page=@(Model.Page - 1)">
                                    Предишна
                                </a>
                            }
                            <span class="px-4 py-2 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-xl font-semibold">Страница @Model.Page</span>
                            @if (Model.Page * Model.PageSize < Model.TotalResults)
                            {
                                <a class="px-4 py-2 bg-white/50 dark:bg-gray-800/50 rounded-xl hover:bg-white/70 dark:hover:bg-gray-700/50 transition-colors" href="?Query=@Model.Query&City=@Model.City&DegreeType=@Model.DegreeType&Page=@(Model.Page + 1)">
                                    Следваща
                                </a>
                            }
                        </div>
                    </nav>
                }
            }
            else
            {
            <div class="glass dark:glass-dark rounded-3xl p-12 text-center">
                <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-green-500 to-emerald-500 flex items-center justify-center">
                        <i data-lucide="building-2" class="w-12 h-12 text-white"></i>
                    </div>
                    <h3 class="text-2xl font-bold mb-3">Не са намерени университети</h3>
                    <p class="text-gray-600 dark:text-gray-400 mb-6">Опитайте се да промените критериите за търсене или разгледайте всички университети.</p>
                    <a asp-action="Index" class="inline-block px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-xl font-semibold hover:shadow-lg transform hover:scale-105 transition-all">
                        Разгледай Всички Университети
                    </a>
                </div>
            }
        }
        else
        {
            <div class="glass dark:glass-dark rounded-3xl p-12 text-center">
                <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-green-500 to-emerald-500 flex items-center justify-center">
                    <i data-lucide="search" class="w-12 h-12 text-white"></i>
                </div>
                <h3 class="text-2xl font-bold mb-3">Започнете Търсенето</h3>
                <p class="text-gray-600 dark:text-gray-400">Въведете предмет или специалност, за да намерите университети, които предлагат програми в тази област.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}

