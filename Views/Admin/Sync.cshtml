@{
    ViewData["Title"] = "Табло за Синхронизация на HEI";
}

<div class="min-h-screen bg-gradient-to-br from-green-50 to-emerald-50 dark:from-gray-900 dark:to-gray-800 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-12">
            <h1 class="text-4xl md:text-5xl font-bold font-display mb-4 gradient-text">Синхронизация на HEI API</h1>
            <p class="text-xl text-gray-600 dark:text-gray-400">Управление на синхронизацията на данни за университети</p>
        </div>
        
        <!-- Alert Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 glass dark:glass-dark rounded-2xl p-4 border-l-4 border-green-500 bg-green-50/50 dark:bg-green-900/20">
                <div class="flex items-center gap-3">
                    <i data-lucide="check-circle" class="w-6 h-6 text-green-500"></i>
                    <p class="text-green-800 dark:text-green-200">@TempData["SuccessMessage"]</p>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-6 glass dark:glass-dark rounded-2xl p-4 border-l-4 border-red-500 bg-red-50/50 dark:bg-red-900/20">
                <div class="flex items-center gap-3">
                    <i data-lucide="alert-circle" class="w-6 h-6 text-red-500"></i>
                    <p class="text-red-800 dark:text-red-200">@TempData["ErrorMessage"]</p>
                </div>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="mb-6 glass dark:glass-dark rounded-2xl p-4 border-l-4 border-blue-500 bg-blue-50/50 dark:bg-blue-900/20">
                <div class="flex items-center gap-3">
                    <i data-lucide="info" class="w-6 h-6 text-blue-500"></i>
                    <p class="text-blue-800 dark:text-blue-200">@TempData["InfoMessage"]</p>
                </div>
            </div>
        }
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Sync from NACID Card -->
            <div class="lg:col-span-1">
                <div class="glass dark:glass-dark rounded-3xl p-8 h-full flex flex-col">
                    <div class="w-16 h-16 mb-6 rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-600 flex items-center justify-center">
                        <i data-lucide="database" class="w-8 h-8 text-white"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-3">Синхронизация от НАЦИД</h2>
                    <p class="text-gray-600 dark:text-gray-400 mb-6 flex-grow">
                        Изтегляне и синхронизиране на университети и специалности от официалния регистър на НАЦИД (rvu.nacid.bg).
                        <br/><br/>
                        <span class="text-sm bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-2 py-1 rounded">
                            Включва: Университети, Специалности (като Предмети)
                        </span>
                    </p>
                    <div class="flex flex-col gap-4">
                        <form asp-action="SyncFromNacid" method="post">
                            @Html.AntiForgeryToken()
                            <button 
                                type="submit" 
                                class="w-full px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-xl font-semibold hover:shadow-lg transform hover:scale-105 transition-all flex items-center justify-center gap-2"
                            >
                                <i data-lucide="refresh-cw" class="w-5 h-5"></i>
                                Синхронизирай от НАЦИД
                            </button>
                        </form>
                        
                        <form asp-action="SeedCategories" method="post">
                            @Html.AntiForgeryToken()
                            <button 
                                type="submit" 
                                class="w-full px-6 py-3 border-2 border-blue-600 text-blue-600 dark:text-blue-400 rounded-xl font-semibold hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-all flex items-center justify-center gap-2"
                            >
                                <i data-lucide="layers" class="w-5 h-5"></i>
                                Генерирай 9-те Категории
                            </button>
                        </form>

                        <form asp-action="ReconcileSubjectCategoriesFromNacid" method="post">
                            @Html.AntiForgeryToken()
                            <button
                                type="submit"
                                class="w-full px-6 py-3 border-2 border-amber-600 text-amber-800 dark:text-amber-300 rounded-xl font-semibold hover:bg-amber-50 dark:hover:bg-amber-900/20 transition-all flex items-center justify-center gap-2"
                            >
                                <i data-lucide="wand-2" class="w-5 h-5"></i>
                                Подравни CategoryId за специалности (НАЦИД)
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            
            <!-- Info Card -->
            <div class="lg:col-span-1">
                <div class="glass dark:glass-dark rounded-3xl p-8">
                    <div class="w-16 h-16 mb-6 rounded-2xl bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center">
                        <i data-lucide="info" class="w-8 h-8 text-white"></i>
                    </div>
                    <h2 class="text-2xl font-bold mb-3">Информация</h2>
                    <p class="text-gray-600 dark:text-gray-400 mb-4">
                        Тази операция ще:
                    </p>
                    <ul class="space-y-2 text-gray-600 dark:text-gray-400 mb-6">
                        <li class="flex items-start gap-2">
                            <i data-lucide="check" class="w-5 h-5 text-green-500 mt-0.5"></i>
                            <span>Изтегли списъка с активни университети от НАЦИД.</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i data-lucide="check" class="w-5 h-5 text-green-500 mt-0.5"></i>
                            <span>Добави нови университети в базата данни (Supabase).</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i data-lucide="check" class="w-5 h-5 text-green-500 mt-0.5"></i>
                            <span>Изтегли списъка със специалности.</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i data-lucide="check" class="w-5 h-5 text-green-500 mt-0.5"></i>
                            <span>Добави специалностите като "Предмети" (Subjects).</span>
                        </li>
                    </ul>
                    <div class="p-4 bg-yellow-50 dark:bg-yellow-900/20 rounded-xl border border-yellow-200 dark:border-yellow-800 space-y-2">
                        <p class="text-sm text-yellow-800 dark:text-yellow-200">
                            <strong>Забележка:</strong> Връзката между университети и специалности все още се проучва и не се импортира автоматично.
                        </p>
                        <p class="text-sm text-yellow-800 dark:text-yellow-200">
                            Ако в админ панела част от категориите нямат специалности в падащото меню, натиснете „Подравни CategoryId“ — обхожда се <strong>цялата</strong> номенклатура от НАЦИД (хиляди записи; може да отнеме малко време) и се обновява <code class="text-xs">CategoryId</code> в <code class="text-xs">Subjects</code> според кода на научната област.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let statusCheckInterval;
        
        function updateSyncStatus() {
            fetch('@Url.Action("GetSyncStatus", "Admin")?syncType=Programs')
                .then(response => response.json())
                .then(data => {
                    const statusBadge = document.getElementById('statusBadge');
                    const statusMessage = document.getElementById('statusMessage');
                    const syncButton = document.getElementById('syncButton');
                    const buttonText = document.getElementById('buttonText');
                    const buttonSpinner = document.getElementById('buttonSpinner');
                    const statusProgress = document.getElementById('statusProgress');
                    const progressBar = document.getElementById('progressBar');
                    const progressText = document.getElementById('progressText');
                    
                    // Update badge
                    if (data.isRunning) {
                        statusBadge.textContent = 'В Изпълнение';
                        statusBadge.className = 'px-4 py-1 rounded-full text-sm font-semibold bg-blue-500 text-white animate-pulse';
                        syncButton.disabled = true;
                        buttonText.textContent = 'Синхронизацията е в процес...';
                        buttonSpinner.classList.remove('hidden');
                        statusProgress.style.display = 'block';
                    } else {
                        statusBadge.textContent = data.status === 'Completed' ? 'Завършена' : data.status === 'Failed' ? 'Неуспешна' : data.status === 'Idle' ? 'Неактивна' : data.status;
                        if (data.status === 'Completed') {
                            statusBadge.className = 'px-4 py-1 rounded-full text-sm font-semibold bg-green-500 text-white';
                        } else if (data.status === 'Failed') {
                            statusBadge.className = 'px-4 py-1 rounded-full text-sm font-semibold bg-red-500 text-white';
                        } else {
                            statusBadge.className = 'px-4 py-1 rounded-full text-sm font-semibold bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300';
                        }
                        syncButton.disabled = false;
                        buttonText.textContent = 'Синхронизирай Програми от HEI API';
                        buttonSpinner.classList.add('hidden');
                        statusProgress.style.display = 'block';
                        
                        if (data.status === 'Completed' || data.status === 'Failed') {
                            progressBar.style.width = '100%';
                            progressText.textContent = '100%';
                        }
                    }
                    
                    // Update message
                    statusMessage.textContent = data.message || 'Няма налично съобщение';
                    
                    // Update progress
                    const progress = Math.min(100, data.progressPercent || 0);
                    progressBar.style.width = progress + '%';
                    progressText.textContent = progress + '%';
                    
                    // Update details
                    document.getElementById('totalItems').textContent = data.totalItems || 0;
                    document.getElementById('processedItems').textContent = data.processedItems || 0;
                    document.getElementById('successCount').textContent = data.successCount || 0;
                    document.getElementById('errorCount').textContent = data.errorCount || 0;
                    
                    // Update last sync time
                    if (data.lastSyncTime) {
                        const syncTime = new Date(data.lastSyncTime);
                        document.getElementById('syncTime').textContent = syncTime.toLocaleString();
                    } else {
                        document.getElementById('syncTime').textContent = 'Никога';
                    }
                    
                    // Stop checking if not running
                    if (!data.isRunning && statusCheckInterval) {
                        clearInterval(statusCheckInterval);
                        statusCheckInterval = null;
                    }
                })
                .catch(error => {
                    console.error('Грешка при извличане на статуса на синхронизация:', error);
                });
        }
        
        // Initial status update
        updateSyncStatus();
        
        // Auto-refresh every 2 seconds if sync is running
        statusCheckInterval = setInterval(() => {
            updateSyncStatus();
        }, 2000);
        
        // Clean up interval on page unload
        window.addEventListener('beforeunload', () => {
            if (statusCheckInterval) {
                clearInterval(statusCheckInterval);
            }
        });
        
        lucide.createIcons();
        
        // Re-initialize icons periodically for spinner animation
        setInterval(() => {
            lucide.createIcons();
        }, 100);
    </script>
}
