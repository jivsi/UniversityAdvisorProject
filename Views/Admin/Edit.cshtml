@model UniversityFinder.Models.University
@{
    ViewData["Title"] = "Редактиране на Университет";
}

<div class="min-h-screen bg-gradient-to-br from-green-50 to-emerald-50 dark:from-gray-900 dark:to-gray-800 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-4xl md:text-5xl font-bold font-display mb-4 gradient-text">Редактиране на Университет</h1>
            <p class="text-xl text-gray-600 dark:text-gray-400">Актуализиране на информацията за университета</p>
        </div>

        <!-- Form -->
        <div class="glass dark:glass-dark rounded-3xl p-8">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="mb-6 text-red-600 dark:text-red-400"></div>

                <div class="mb-6">
                    <label asp-for="Name" class="block text-sm font-semibold mb-2">Име на Университет *</label>
                    <input asp-for="Name" class="w-full px-4 py-3 rounded-xl bg-white/50 dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400" placeholder="Въведете име на университет" />
                    <span asp-validation-for="Name" class="text-red-600 dark:text-red-400 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="City" class="block text-sm font-semibold mb-2">Град *</label>
                    <input asp-for="City" class="w-full px-4 py-3 rounded-xl bg-white/50 dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400" placeholder="Въведете град" />
                    <span asp-validation-for="City" class="text-red-600 dark:text-red-400 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Website" class="block text-sm font-semibold mb-2">Уебсайт</label>
                    <input asp-for="Website" type="url" class="w-full px-4 py-3 rounded-xl bg-white/50 dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400" placeholder="https://example.com" />
                    <span asp-validation-for="Website" class="text-red-600 dark:text-red-400 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Email" class="block text-sm font-semibold mb-2">Имейл</label>
                    <input asp-for="Email" type="email" class="w-full px-4 py-3 rounded-xl bg-white/50 dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400" placeholder="contact@university.edu" />
                    <span asp-validation-for="Email" class="text-red-600 dark:text-red-400 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Phone" class="block text-sm font-semibold mb-2">Телефон</label>
                    <input asp-for="Phone" type="tel" class="w-full px-4 py-3 rounded-xl bg-white/50 dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400" placeholder="+359 2 123 4567" />
                    <span asp-validation-for="Phone" class="text-red-600 dark:text-red-400 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Address" class="block text-sm font-semibold mb-2">Адрес</label>
                    <textarea asp-for="Address" rows="3" class="w-full px-4 py-3 rounded-xl bg-white/50 dark:bg-gray-800/50 border border-gray-300 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400" placeholder="Адрес, град"></textarea>
                    <span asp-validation-for="Address" class="text-red-600 dark:text-red-400 text-sm"></span>
                </div>

                <div class="flex items-center gap-4">
                    <button type="submit" class="px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-xl font-semibold hover:shadow-lg transform hover:scale-105 transition-all flex items-center gap-2">
                        <i data-lucide="save" class="w-5 h-5"></i>
                        Актуализирай Университет
                    </button>
                    <a asp-action="ManagePrograms" asp-route-id="@Model.Id" class="px-6 py-3 bg-blue-500 text-white rounded-xl font-semibold hover:bg-blue-600 transition-colors flex items-center gap-2">
                        <i data-lucide="book-open" class="w-5 h-5"></i>
                        Управлявай Специалности
                    </a>
                    <a asp-action="Index" class="px-6 py-3 bg-gray-500 text-white rounded-xl font-semibold hover:bg-gray-600 transition-colors">
                        Отказ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

