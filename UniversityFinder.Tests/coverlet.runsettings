<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[UniversityFinder]AspNetCoreGeneratedDocument*</Exclude>
          <Exclude>[UniversityFinder]*.Program</Exclude>
          <Exclude>[UniversityFinder]AutoGeneratedProgram</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
